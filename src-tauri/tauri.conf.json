{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PowerPlan",
  "version": "2026.9.23",
  "identifier": "com.blazesnow.powerplan",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PowerPlan",
        "width": 880,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": ["icons/icon.ico"]
  }
}
