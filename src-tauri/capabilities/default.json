{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口默认能力：外部链接",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://www.blazesnow.com" },
        { "url": "https://www.blazesnow.com/*" },
        { "url": "https://github.com/BlazeSnow/PowerPlan.Rust" },
        { "url": "https://github.com/BlazeSnow/PowerPlan.Rust/*" }
      ]
    }
  ]
}
